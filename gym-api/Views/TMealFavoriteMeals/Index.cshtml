@model IEnumerable<gym_api.Models.TMealFavoriteMeal>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FCreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FMeal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FUser)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FCreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FMeal.FMealName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FUser.Account)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FFavoriteMealId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FFavoriteMealId">Details</a> |
